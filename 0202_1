import json
import requests

# Cấu hình kết nối tới Local LLM (vLLM/Ollama)
API_URL = "http://localhost:8000/v1/chat/completions" 
API_KEY = "token-tuy-y" # Thường để trống nếu chạy local

def call_local_llm(system_prompt, user_prompt):
    payload = {
        "model": "qwen2.5-32b-instruct", # Thay bằng tên model bạn đang chạy
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "temperature": 0.7,
        "response_format": { "type": "json_object" } # Ép model trả về JSON
    }
    response = requests.post(API_URL, json=payload)
    return response.json()['choices'][0]['message']['content']

# 1. Hàm sinh dữ liệu (Augmentation)
def generate_variations(intent_name, situation_name):
    system_prompt = """Bạn là chuyên gia ngôn ngữ tiếng Nhật. 
    Dựa trên Intent và Situation cho trước, hãy tạo ra 5 câu hỏi thực tế mà người dùng thường hỏi.
    Yêu cầu: Câu văn tự nhiên, đa dạng (lịch sự, ngắn gọn, lo lắng).
    Trả về định dạng JSON: {"variations": ["câu 1", "câu 2", ...]}"""
    
    user_prompt = f"Intent: {intent_name}\nSituation: {situation_name}"
    return json.loads(call_local_llm(system_prompt, user_prompt))['variations']



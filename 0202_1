# 2. Hàm kiểm tra chéo (Verification) - Để đảm bảo AI không sinh sai
def verify_sample(question, original_intent):
    system_prompt = f"Bạn là giám thị. Hãy xác định câu hỏi sau có thuộc nhóm '{original_intent}' không? Trả về JSON: {'is_correct': true/false}"
    user_prompt = f"Câu hỏi: {question}"
    result = json.loads(call_local_llm(system_prompt, user_prompt))
    return result.get('is_correct', False)


